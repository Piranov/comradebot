[Unit]
Description=ComradeBot IRC instance (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/comradebot
EnvironmentFile=%h/projects/comradebot/%i.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/projects/comradebot/.venv/bin/python %h/projects/comradebot/bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
